; Engine configuration file.
; Nakshatra: The Sky Weavers — a web-first 3D sky lab.

config_version=5

[application]

config/name="Nakshatra: The Sky Weavers"
config/description="A hand-crafted 3D sky lab for curious middle-school minds."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027451, 0.043137, 0.086275, 1)

[autoload]

G="*res://scripts/G.gd"
StarDB="*res://scripts/Sky.gd"
Sfx="*res://scripts/Sfx.gd"
Router="*res://scripts/Router.gd"
DevCapture="*res://scripts/DevCapture.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.027451, 0.043137, 0.086275, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0

[audio]
